{
  "name": "claude-flow",
  "displayName": "Claude Flow - Agent Orchestration Platform",
  "version": "3.5.15",
  "description": "Multi-agent swarm orchestration, coordination, and workflow automation for Claude Code",
  "author": "ruvnet",
  "license": "MIT",
  "repository": "https://github.com/ruvnet/claude-flow",
  "homepage": "https://github.com/ruvnet/claude-flow",
  "engines": {
    "claude-code": ">=2.1.0",
    "node": ">=20.0.0"
  },
  "package": "ruflo@latest",
  "entrypoint": "npx ruflo@latest",
  "capabilities": {
    "mcp": true,
    "hooks": true,
    "commands": true,
    "skills": true,
    "agents": true,
    "statusLine": true
  },
  "components": {
    "commands": 81,
    "skills": 30,
    "agents": 99,
    "helpers": 41,
    "hooks": 10
  },
  "mcp": {
    "serverName": "claude-flow",
    "command": "npx",
    "args": ["-y", "ruflo@latest", "mcp", "start"],
    "env": {
      "CLAUDE_FLOW_MODE": "v3",
      "CLAUDE_FLOW_HOOKS_ENABLED": "true",
      "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
      "CLAUDE_FLOW_MAX_AGENTS": "15",
      "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
    }
  },
  "hooks": {
    "PreToolUse": ["pre-bash", "pre-edit"],
    "PostToolUse": ["post-edit", "post-bash"],
    "UserPromptSubmit": ["route"],
    "SessionStart": ["session-restore", "memory-import"],
    "SessionEnd": ["session-end"],
    "Stop": ["memory-sync"],
    "PreCompact": ["compact-manual", "compact-auto"],
    "SubagentStart": ["status"],
    "SubagentStop": ["post-task"],
    "Notification": ["notify"]
  },
  "categories": [
    "orchestration",
    "multi-agent",
    "swarm",
    "automation",
    "workflow"
  ],
  "keywords": [
    "claude-code",
    "plugin",
    "agent-orchestration",
    "swarm-intelligence",
    "multi-agent",
    "mcp",
    "sparc",
    "coordination"
  ]
}
